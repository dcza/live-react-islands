{
  "name": "@live-react-islands/core",
  "version": "0.1.2",
  "description": "Core React integration for LiveReactIslands - Phoenix LiveView hook and utilities",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./ssr": {
      "types": "./dist/ssr.d.ts",
      "import": "./dist/ssr.esm.js",
      "require": "./dist/ssr.js"
    }
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "jest",
    "clean": "rm -rf dist",
    "prepublishOnly": "cp ../../../README.md ./"
  },
  "keywords": [
    "phoenix",
    "liveview",
    "react",
    "islands",
    "ssr",
    "elixir"
  ],
  "author": "David Czaplinski",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dcza/live-react-islands.git",
    "directory": "packages/js/core"
  },
  "peerDependencies": {
    "phoenix": "^1.7.0 || ^1.8.0",
    "phoenix_live_view": "^1.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rollup": "^4.63.1",
    "ts-jest": "^29.4.12",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
